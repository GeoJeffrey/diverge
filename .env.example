# Backend configuration. Copy to `.env` and fill in real values. Never commit `.env`.

# PostgreSQL recommended; leave unset to use the SQLite fallback.
DATABASE_URL=postgresql://user:password@localhost:5432/diverge

# Secret used to sign JWTs. Generate a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DIVERGE_SECRET_KEY=change-me

# Token lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Allowed frontend origins (comma separated)
CORS_ORIGINS=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Server
HOST=0.0.0.0
PORT=8000
